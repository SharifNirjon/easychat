# Copy to api/.env and fill in. api/.env is git-ignored — never commit real keys.

# local | test | staging | production   (docs at /docs and PRIVACY_MODE=dev only in local/test)
APP_ENV=local

# OpenRouter (OpenAI-compatible)
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-REPLACE_ME

# Chat model + fallbacks (sent as OpenRouter's `models` array, tried in order)
CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
FALLBACK_MODELS=openai/gpt-oss-20b

# strict (default) = provider {"data_collection":"deny","zdr":true,"sort":"latency"}
# dev              = no provider prefs, so free models work. Refused unless APP_ENV is local/test.
PRIVACY_MODE=dev

# off | low  (off = fastest first token)
REASONING=off

# Reply limits
MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=20

# Postgres. The API connects as a NON-owner role (member of easychat_app) so row-level security
# applies to it. Migrations and seeding use the owner. In local/test, `python migrate.py`
# creates the API role from DATABASE_URL; in staging/production, infrastructure creates it.
DATABASE_URL=postgresql://easychat_api:local-api-password@localhost:5432/easychat
MIGRATION_DATABASE_URL=postgresql://easychat:easychat@localhost:5432/easychat

REDIS_URL=redis://localhost:6379/0

# Abuse limits (per-tenant caps live in each tenant's `limits`)
IP_MESSAGES_PER_MINUTE=20
MAX_REQUEST_BYTES=16384
# Reverse proxies that append to X-Forwarded-For. 0 locally; set for the real deployment.
TRUSTED_PROXY_HOPS=0
