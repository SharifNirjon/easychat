# Copy to api/.env and fill in. api/.env is git-ignored — never commit real keys.

# OpenRouter (OpenAI-compatible)
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-REPLACE_ME

# Chat model + fallbacks (sent as OpenRouter's `models` array, tried in order)
CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
FALLBACK_MODELS=openai/gpt-oss-20b

# dev    = no provider prefs (free models allowed)
# strict = provider {"data_collection":"deny","zdr":true,"sort":"latency"} — use in production
PRIVACY_MODE=dev

# off | low  (off = fastest first token)
REASONING=off

# Reply limits
MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=20


